<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="drone_navigation_test">

    <!-- Physics -->
    <physics name="1ms" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <!-- Gazebo Sensors System: required for GPU LiDAR -->
    <plugin
      filename="gz-sim-sensors-system"
      name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- Lighting -->
    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>true</shadows>
    </scene>

    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 20 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.3 -0.4 -1</direction>
    </light>

    <!-- Ground -->
    <model name="ground">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>60 60</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>60 60</size>
            </plane>
          </geometry>
        </visual>
      </link>
    </model>

    <!-- Outer boundary walls -->
    <model name="wall_north">
      <static>true</static>
      <pose>0 15 2 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>30 0.3 4</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>30 0.3 4</size></box></geometry>
        </visual>
      </link>
    </model>

    <model name="wall_south">
      <static>true</static>
      <pose>0 -15 2 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>30 0.3 4</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>30 0.3 4</size></box></geometry>
        </visual>
      </link>
    </model>

    <model name="wall_east">
      <static>true</static>
      <pose>15 0 2 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.3 30 4</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.3 30 4</size></box></geometry>
        </visual>
      </link>
    </model>

    <model name="wall_west">
      <static>true</static>
      <pose>-15 0 2 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.3 30 4</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.3 30 4</size></box></geometry>
        </visual>
      </link>
    </model>

    <!-- Obstacle 1: central block -->
    <model name="obstacle_central">
      <static>true</static>
      <pose>0 0 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>4 4 3</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>4 4 3</size></box></geometry>
        </visual>
      </link>
    </model>

    <!-- Obstacle 2: left block -->
    <model name="obstacle_left">
      <static>true</static>
      <pose>-6 5 2 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>3 6 4</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>3 6 4</size></box></geometry>
        </visual>
      </link>
    </model>

    <!-- Obstacle 3: right block -->
    <model name="obstacle_right">
      <static>true</static>
      <pose>6 7 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>3 4 3</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>3 4 3</size></box></geometry>
        </visual>
      </link>
    </model>

    <!-- Obstacle 4: horizontal barrier with a gap -->
    <model name="barrier_left">
      <static>true</static>
      <pose>-5 -6 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>8 1.5 3</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>8 1.5 3</size></box></geometry>
        </visual>
      </link>
    </model>

    <model name="barrier_right">
      <static>true</static>
      <pose>5 -6 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>8 1.5 3</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>8 1.5 3</size></box></geometry>
        </visual>
      </link>
    </model>

    <!-- Tall obstacle -->
    <model name="tall_obstacle">
      <static>true</static>
      <pose>0 9 4 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>3 3 8</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>3 3 8</size></box></geometry>
        </visual>
      </link>
    </model>

    <!-- Start marker -->
    <model name="start_marker">
      <static>true</static>
      <pose>-12 -10 0.02 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <cylinder><radius>1.2</radius><length>0.04</length></cylinder>
          </geometry>
        </visual>
      </link>
    </model>

    <!-- Destination marker -->
    <model name="destination_marker">
      <static>true</static>
      <pose>12 10 0.02 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <cylinder><radius>1.5</radius><length>0.04</length></cylinder>
          </geometry>
        </visual>
      </link>
    </model>

    <!-- ============================================================
         DRONE
         iris_navigation contains iris_with_standoffs.
         The LiDAR is installed directly inside the base model.
         ============================================================ -->
    <include>
      <uri>model://iris_navigation</uri>
      <name>iris_navigation</name>
      <pose>-12 -10 2 0 0 0</pose>
    </include>

  </world>
</sdf>
